{
  "name": "migent-vscode",
  "displayName": "Migent",
  "description": "Monitor and run Migent sessions and workflows from VS Code.",
  "version": "0.0.1",
  "publisher": "nodeint",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodeint/migent-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.migent/config.yaml"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "migent.refresh",
        "title": "Refresh",
        "category": "Migent",
        "icon": "$(refresh)"
      },
      {
        "command": "migent.session.openTask",
        "title": "Open Task",
        "category": "Migent"
      },
      {
        "command": "migent.session.openPrompt",
        "title": "Open Prompt",
        "category": "Migent"
      },
      {
        "command": "migent.session.openResponse",
        "title": "Open Response",
        "category": "Migent"
      },
      {
        "command": "migent.session.openOutput",
        "title": "Open Output",
        "category": "Migent"
      },
      {
        "command": "migent.session.openQuestions",
        "title": "Open Questions File",
        "category": "Migent"
      },
      {
        "command": "migent.session.copyId",
        "title": "Copy Session ID",
        "category": "Migent"
      },
      {
        "command": "migent.session.revealInExplorer",
        "title": "Reveal Session in File Explorer",
        "category": "Migent"
      },
      {
        "command": "migent.sessions.showMore",
        "title": "Show More Sessions",
        "category": "Migent"
      }
    ],
    "configuration": {
      "title": "Migent",
      "properties": {
        "migent.sessions.limit": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "scope": "resource",
          "description": "Show this many of the most recent sessions. Running sessions and sessions that need attention are always shown."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "migent",
          "title": "Migent",
          "icon": "media/migent.svg"
        }
      ]
    },
    "views": {
      "migent": [
        {
          "id": "migent.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "migent.sessions",
        "contents": "No Migent project was found in the open folders.\nCreate one with the Migent CLI and it appears here.",
        "when": "!migent.hasProjects"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "migent.refresh",
          "when": "view == migent.sessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "migent.session.openTask",
          "when": "view == migent.sessions && viewItem =~ /^session./",
          "group": "1_open@1"
        },
        {
          "command": "migent.session.openQuestions",
          "when": "view == migent.sessions && viewItem =~ /^session..*;questions(;|$)/",
          "group": "1_open@2"
        },
        {
          "command": "migent.session.openOutput",
          "when": "view == migent.sessions && viewItem =~ /^session..*;outputs(;|$)/",
          "group": "1_open@3"
        },
        {
          "command": "migent.session.openPrompt",
          "when": "view == migent.sessions && viewItem =~ /^execution./",
          "group": "1_open@1"
        },
        {
          "command": "migent.session.openResponse",
          "when": "view == migent.sessions && viewItem =~ /^execution./",
          "group": "1_open@2"
        },
        {
          "command": "migent.session.copyId",
          "when": "view == migent.sessions && viewItem =~ /^session./",
          "group": "2_session@1"
        },
        {
          "command": "migent.session.revealInExplorer",
          "when": "view == migent.sessions && viewItem =~ /^session./",
          "group": "2_session@2"
        }
      ],
      "commandPalette": [
        {
          "command": "migent.sessions.showMore",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "setup:git": "node scripts/setup-git.mjs",
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:integration": "node scripts/integration/run.mjs",
    "package": "vsce package --no-dependencies",
    "lint": "node scripts/wrappers/run-eslint.mjs",
    "lint:strict": "node scripts/wrappers/run-eslint.mjs --max-warnings 0",
    "lint:fix": "node scripts/wrappers/run-eslint.mjs --fix",
    "lint:md": "node scripts/docs/lint-md.mjs",
    "lint:md:fix": "node scripts/docs/lint-md.mjs --fix",
    "lint:md:links": "node scripts/docs/lint-md-links.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "markdownlint-cli2": "^0.23.3",
    "ovsx": "1.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}