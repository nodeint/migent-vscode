{
  "name": "migent-vscode",
  "displayName": "Migent",
  "description": "Monitor and run Migent sessions and workflows from VS Code.",
  "version": "0.0.1",
  "publisher": "nodeint",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodeint/migent-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.migent/config.yaml"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "migent.refresh",
        "title": "Refresh",
        "category": "Migent"
      }
    ]
  },
  "scripts": {
    "setup:git": "node scripts/setup-git.mjs",
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.2",
    "ovsx": "1.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
