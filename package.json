{
  "name": "migent-vscode",
  "displayName": "Migent",
  "description": "Monitor and run Migent sessions and workflows from VS Code.",
  "version": "0.0.1",
  "publisher": "nodeint",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodeint/migent-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.migent/config.yaml"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "migent.refresh",
        "title": "Refresh",
        "category": "Migent"
      }
    ]
  },
  "scripts": {
    "setup:git": "node scripts/setup-git.mjs",
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "package": "vsce package --no-dependencies",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:md": "node scripts/docs/lint-md.mjs",
    "lint:md:fix": "node scripts/docs/lint-md.mjs --fix",
    "lint:md:links": "node scripts/docs/lint-md-links.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "ovsx": "1.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
