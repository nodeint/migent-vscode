{
  "name": "migent-vscode",
  "displayName": "Migent",
  "description": "Workflow runner and AI agent orchestrator for VS Code.",
  "version": "0.1.11",
  "publisher": "nodeint",
  "icon": "media/migent.png",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodeint/migent-vscode.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.migent/config.yaml",
    "onWebviewPanel:migent.results",
    "onWebviewPanel:migent.sessionMetrics",
    "onWebviewPanel:migent.answerQuestions",
    "onWebviewPanel:migent.editWorkflow",
    "onWebviewPanel:migent.config"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "migent.refresh",
        "title": "Refresh",
        "category": "Migent",
        "icon": "$(refresh)"
      },
      {
        "command": "migent.session.open",
        "title": "Open Session",
        "category": "Migent",
        "icon": "$(book)"
      },
      {
        "command": "migent.session.answer",
        "title": "Answer Questions",
        "category": "Migent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "migent.session.openNextStep",
        "title": "Open Next Step…",
        "category": "Migent",
        "icon": "$(arrow-right)"
      },
      {
        "command": "migent.session.openTask",
        "title": "Open Task",
        "category": "Migent",
        "shortTitle": "Open Task",
        "icon": "$(file-text)"
      },
      {
        "command": "migent.session.openPrompt",
        "title": "Open Prompt",
        "category": "Migent"
      },
      {
        "command": "migent.session.openResponse",
        "title": "Open Response",
        "category": "Migent"
      },
      {
        "command": "migent.session.openFailure",
        "title": "Open Failure Report",
        "category": "Migent",
        "shortTitle": "Open Failure"
      },
      {
        "command": "migent.session.openOutput",
        "title": "Open Output",
        "category": "Migent",
        "shortTitle": "Open Result File",
        "icon": "$(package)"
      },
      {
        "command": "migent.session.openQuestions",
        "title": "Open Questions File",
        "category": "Migent",
        "shortTitle": "Open Questions"
      },
      {
        "command": "migent.session.showLog",
        "title": "Show Session Log",
        "category": "Migent",
        "shortTitle": "View Log",
        "icon": "$(output)"
      },
      {
        "command": "migent.session.showTimeline",
        "title": "Show Session Timeline",
        "category": "Migent"
      },
      {
        "command": "migent.session.copyId",
        "title": "Copy Session ID",
        "category": "Migent",
        "shortTitle": "Copy ID"
      },
      {
        "command": "migent.session.delete",
        "title": "Delete Session",
        "category": "Migent",
        "shortTitle": "Delete"
      },
      {
        "command": "migent.session.revealInExplorer",
        "title": "Reveal Session in File Explorer",
        "category": "Migent",
        "shortTitle": "Reveal in Explorer"
      },
      {
        "command": "migent.sessions.showMore",
        "title": "Show More Sessions",
        "category": "Migent"
      },
      {
        "command": "migent.cli.install",
        "title": "Install or Update CLI",
        "category": "Migent"
      },
      {
        "command": "migent.cli.recheck",
        "title": "Recheck CLI",
        "category": "Migent",
        "icon": "$(refresh)"
      },
      {
        "command": "migent.workflow.open",
        "title": "Open Workflow File",
        "category": "Migent"
      },
      {
        "command": "migent.workflow.edit",
        "title": "Edit Workflow",
        "category": "Migent"
      },
      {
        "command": "migent.workflow.new",
        "title": "New Workflow",
        "category": "Migent",
        "icon": "$(add)"
      },
      {
        "command": "migent.workflow.duplicate",
        "title": "Duplicate Workflow",
        "category": "Migent"
      },
      {
        "command": "migent.workflow.delete",
        "title": "Delete Workflow",
        "category": "Migent"
      },
      {
        "command": "migent.openConfigFile",
        "title": "Open Configuration File (YAML)",
        "category": "Migent",
        "icon": "$(go-to-file)"
      },
      {
        "command": "migent.openConfig",
        "title": "Open Configuration",
        "category": "Migent",
        "icon": "$(settings-gear)"
      },
      {
        "command": "migent.session.run",
        "title": "Run Workflow…",
        "category": "Migent",
        "icon": "$(play)"
      },
      {
        "command": "migent.session.new",
        "title": "New session",
        "category": "Migent",
        "icon": "$(play)"
      },
      {
        "command": "migent.session.prepare",
        "title": "Prepare Session…",
        "category": "Migent",
        "icon": "$(add)"
      },
      {
        "command": "migent.session.start",
        "title": "Save & Run",
        "category": "Migent",
        "shortTitle": "Save & Run",
        "icon": "$(play)"
      },
      {
        "command": "migent.session.continue",
        "title": "Continue Session",
        "category": "Migent",
        "shortTitle": "Continue",
        "icon": "$(debug-continue)"
      },
      {
        "command": "migent.session.cancel",
        "title": "Stop Session",
        "category": "Migent",
        "shortTitle": "Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "migent.workflow.run",
        "title": "New Session from Workflow",
        "category": "Migent",
        "icon": "$(play)",
        "shortTitle": "New session"
      },
      {
        "command": "migent.session.reply",
        "title": "Reply to Session",
        "category": "Migent",
        "shortTitle": "Reply",
        "icon": "$(reply)"
      },
      {
        "command": "migent.session.sendReply",
        "title": "Send Reply",
        "category": "Migent",
        "shortTitle": "Send Reply",
        "icon": "$(send)"
      },
      {
        "command": "migent.session.discardReply",
        "title": "Discard Reply…",
        "category": "Migent",
        "shortTitle": "Discard Reply"
      },
      {
        "command": "migent.session.continueOnce",
        "title": "Run Next Stage Once",
        "category": "Migent",
        "shortTitle": "Run next stage once"
      },
      {
        "command": "migent.session.continueWithoutReply",
        "title": "Continue Without Reply",
        "category": "Migent",
        "shortTitle": "Continue without reply"
      },
      {
        "command": "migent.session.complete",
        "title": "Complete Session…",
        "category": "Migent",
        "shortTitle": "Complete…"
      },
      {
        "command": "migent.session.rename",
        "title": "Rename Session…",
        "category": "Migent",
        "shortTitle": "Rename…"
      },
      {
        "command": "migent.session.repair",
        "title": "Repair Session…",
        "category": "Migent",
        "shortTitle": "Repair…"
      },
      {
        "command": "migent.doctor",
        "title": "Run Doctor",
        "category": "Migent",
        "shortTitle": "Doctor"
      },
      {
        "command": "migent.init",
        "title": "Initialize Project…",
        "category": "Migent",
        "shortTitle": "Initialize project"
      }
    ],
    "configuration": {
      "title": "Migent",
      "properties": {
        "migent.notifications.blocked": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Notify when a session becomes blocked and needs a reply."
        },
        "migent.notifications.failed": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Notify when a session fails."
        },
        "migent.notifications.completed": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Notify when a session completes."
        },
        "migent.notifications.question": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Notify when a session starts waiting for answers to human questions."
        },
        "migent.sessions.limit": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "scope": "resource",
          "description": "Show this many of the most recent sessions. Running sessions and sessions that need attention are always shown."
        },
        "migent.run.maxDispatches": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "scope": "resource",
          "description": "Stage dispatches allowed in one run or continue command (passed as --max-dispatches)."
        },
        "migent.run.progress": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Print each tool call when it finishes in the Migent output (passed as --progress)."
        },
        "migent.env": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "scope": "resource",
          "markdownDescription": "Extra environment variables for the Migent CLI, added to the environment VS Code inherits."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "migent",
          "title": "Migent",
          "icon": "media/migent-outline.svg"
        }
      ]
    },
    "views": {
      "migent": [
        {
          "id": "migent.sessions",
          "name": "Sessions"
        },
        {
          "id": "migent.workflows",
          "name": "Workflows"
        },
        {
          "id": "migent.project",
          "name": "Configuration"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "migent.sessions",
        "contents": "Checking for the Migent CLI…",
        "when": "!migent.cliInstalling && migent.cliState == checking"
      },
      {
        "view": "migent.sessions",
        "contents": "Installing the Migent CLI… This updates when the install finishes.\n[Recheck CLI](command:migent.cli.recheck)",
        "when": "migent.cliInstalling"
      },
      {
        "view": "migent.sessions",
        "contents": "The Migent CLI is not installed.\n[Install Migent CLI](command:migent.cli.install)",
        "when": "!migent.cliInstalling && migent.cliState == missing"
      },
      {
        "view": "migent.sessions",
        "contents": "The Migent CLI is older than required.\n[Update Migent CLI](command:migent.cli.install)",
        "when": "!migent.cliInstalling && migent.cliState == old"
      },
      {
        "view": "migent.sessions",
        "contents": "The Migent CLI is older than required, so new sessions cannot be started from here. Sessions already on disk stay visible.\n[Update Migent CLI](command:migent.cli.install)",
        "when": "!migent.cliInstalling && migent.hasProjects && migent.cliState == old"
      },
      {
        "view": "migent.sessions",
        "contents": "The Migent CLI could not be used.\n[Recheck CLI](command:migent.cli.recheck)\nSee the [Migent README](https://github.com/nodeint/migent#readme) for help.",
        "when": "!migent.hasProjects && migent.cliState =~ /^(unsupported|unparsable|error)$/"
      },
      {
        "view": "migent.sessions",
        "contents": "No Migent project was found in the open folders.\nInitialize one here, or create it with the Migent CLI and it appears here.\n[Initialize project](command:migent.init)",
        "when": "!migent.hasProjects && migent.cliState == ok"
      },
      {
        "view": "migent.sessions",
        "contents": "The Migent CLI is not usable, so new sessions cannot be started from here. Sessions already on disk stay visible.\n[Recheck CLI](command:migent.cli.recheck)",
        "when": "migent.hasProjects && migent.cliState =~ /^(unsupported|unparsable|error)$/"
      },
      {
        "view": "migent.sessions",
        "contents": "No sessions yet.\n[Run workflow](command:migent.session.run)",
        "when": "migent.hasProjects && migent.cliState == ok && migent.sessionsState == empty"
      },
      {
        "view": "migent.workflows",
        "contents": "No Migent project was found in the open folders.",
        "when": "!migent.hasProjects"
      },
      {
        "view": "migent.project",
        "contents": "No Migent project was found in the open folders.",
        "when": "!migent.hasProjects"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "migent.session.new",
          "when": "view == migent.sessions && migent.hasProjects && migent.cliState == ok",
          "group": "navigation@0"
        },
        {
          "command": "migent.refresh",
          "when": "view == migent.sessions",
          "group": "navigation"
        },
        {
          "command": "migent.workflow.new",
          "when": "view == migent.workflows && migent.hasProjects",
          "group": "navigation@0"
        },
        {
          "command": "migent.refresh",
          "when": "view == migent.workflows",
          "group": "navigation"
        },
        {
          "command": "migent.refresh",
          "when": "view == migent.project",
          "group": "navigation"
        },
        {
          "command": "migent.doctor",
          "when": "view == migent.project",
          "group": "1_diagnostics"
        }
      ],
      "view/item/context": [
        {
          "command": "migent.session.delete",
          "when": "view == migent.sessions && viewItem =~ /^session./",
          "group": "9_delete"
        },
        {
          "command": "migent.cli.recheck",
          "when": "view == migent.sessions && viewItem == diag.cli",
          "group": "inline@1"
        },
        {
          "command": "migent.session.answer",
          "when": "view == migent.sessions && viewItem =~ /^session..*;questions(;|$)/",
          "group": "inline@3"
        },
        {
          "command": "migent.session.openQuestions",
          "when": "view == migent.sessions && viewItem =~ /^session..*;questions(;|$)/",
          "group": "1_open@2"
        },
        {
          "command": "migent.session.openOutput",
          "when": "view == migent.sessions && viewItem =~ /^session..*;outputs(;|$)/",
          "group": "1_open@3"
        },
        {
          "command": "migent.session.showLog",
          "when": "view == migent.sessions && viewItem =~ /^session./",
          "group": "1_open@4"
        },
        {
          "command": "migent.session.showTimeline",
          "when": "view == migent.sessions && viewItem =~ /^session./",
          "group": "1_open@5"
        },
        {
          "command": "migent.session.copyId",
          "when": "view == migent.sessions && viewItem =~ /^session./",
          "group": "2_session@1"
        },
        {
          "command": "migent.refresh",
          "when": "(view == migent.workflows || view == migent.project) && viewItem == diag.workflows-unreadable",
          "group": "inline@1"
        },
        {
          "command": "migent.session.start",
          "when": "view == migent.sessions && viewItem =~ /^session.prepared/",
          "group": "inline@0"
        },
        {
          "command": "migent.session.cancel",
          "when": "view == migent.sessions && viewItem =~ /^session.running/",
          "group": "inline@0"
        },
        {
          "command": "migent.session.continue",
          "when": "view == migent.sessions && viewItem =~ /^session\\.(stopped|cancelled|failed)/",
          "group": "inline@0"
        },
        {
          "command": "migent.workflow.run",
          "when": "view == migent.workflows && viewItem == workflow.ok",
          "group": "inline@0"
        },
        {
          "command": "migent.workflow.open",
          "when": "view == migent.workflows && viewItem =~ /^workflow/",
          "group": "1_open@1"
        },
        {
          "command": "migent.workflow.duplicate",
          "when": "view == migent.workflows && viewItem =~ /^workflow/",
          "group": "2_manage@1"
        },
        {
          "command": "migent.workflow.delete",
          "when": "view == migent.workflows && viewItem =~ /^workflow/",
          "group": "2_manage@2"
        },
        {
          "command": "migent.session.reply",
          "when": "view == migent.sessions && viewItem =~ /;reply(;|$)/",
          "group": "inline@0"
        },
        {
          "command": "migent.session.continueOnce",
          "when": "view == migent.sessions && viewItem =~ /^session\\.(stopped|cancelled|failed|blocked)/ && !(viewItem =~ /;questions(;|$)/)",
          "group": "3_more@1"
        },
        {
          "command": "migent.session.continueWithoutReply",
          "when": "view == migent.sessions && viewItem =~ /^session\\.blocked/ && !(viewItem =~ /;questions(;|$)/)",
          "group": "3_more@2"
        },
        {
          "command": "migent.session.complete",
          "when": "view == migent.sessions && viewItem =~ /^session\\.(stopped|cancelled|failed|blocked|question)/ && !(viewItem =~ /;role(;|$)/)",
          "group": "3_more@3"
        },
        {
          "command": "migent.session.rename",
          "when": "view == migent.sessions && viewItem =~ /^session\\./",
          "group": "3_more@5"
        },
        {
          "command": "migent.session.repair",
          "when": "view == migent.sessions && viewItem =~ /^session\\.(?!running)/",
          "group": "3_more@4"
        }
      ],
      "commandPalette": [
        {
          "command": "migent.session.new",
          "when": "false"
        },
        {
          "command": "migent.session.delete",
          "when": "false"
        },
        {
          "command": "migent.session.open",
          "when": "false"
        },
        {
          "command": "migent.session.answer",
          "when": "false"
        },
        {
          "command": "migent.session.openNextStep",
          "when": "false"
        },
        {
          "command": "migent.session.openTask",
          "when": "false"
        },
        {
          "command": "migent.session.openPrompt",
          "when": "false"
        },
        {
          "command": "migent.session.openResponse",
          "when": "false"
        },
        {
          "command": "migent.session.openFailure",
          "when": "false"
        },
        {
          "command": "migent.session.openOutput",
          "when": "false"
        },
        {
          "command": "migent.session.openQuestions",
          "when": "false"
        },
        {
          "command": "migent.session.showLog",
          "when": "false"
        },
        {
          "command": "migent.session.showTimeline",
          "when": "false"
        },
        {
          "command": "migent.session.copyId",
          "when": "false"
        },
        {
          "command": "migent.session.revealInExplorer",
          "when": "false"
        },
        {
          "command": "migent.sessions.showMore",
          "when": "false"
        },
        {
          "command": "migent.cli.recheck",
          "when": "false"
        },
        {
          "command": "migent.cli.install",
          "when": "!migent.cliInstalling && migent.cliState =~ /^(missing|old)$/"
        },
        {
          "command": "migent.workflow.open",
          "when": "false"
        },
        {
          "command": "migent.workflow.edit",
          "when": "false"
        },
        {
          "command": "migent.session.start",
          "when": "false"
        },
        {
          "command": "migent.session.continue",
          "when": "false"
        },
        {
          "command": "migent.session.cancel",
          "when": "false"
        },
        {
          "command": "migent.workflow.run",
          "when": "false"
        },
        {
          "command": "migent.session.reply",
          "when": "false"
        },
        {
          "command": "migent.session.sendReply",
          "when": "false"
        },
        {
          "command": "migent.session.discardReply",
          "when": "false"
        },
        {
          "command": "migent.session.continueOnce",
          "when": "false"
        },
        {
          "command": "migent.session.continueWithoutReply",
          "when": "false"
        },
        {
          "command": "migent.session.complete",
          "when": "false"
        },
        {
          "command": "migent.session.rename",
          "when": "false"
        },
        {
          "command": "migent.session.repair",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "migent.session.start",
          "when": "resourceFilename == task.md && resourcePath =~ /[\\\\/]\\.migent[\\\\/]sessions[\\\\/]/",
          "group": "navigation@0"
        },
        {
          "command": "migent.workflow.run",
          "when": "resourcePath =~ /[\\\\/]\\.migent[\\\\/]workflows[\\\\/][^\\\\/]+\\.ya?ml$/",
          "group": "navigation@0"
        },
        {
          "command": "migent.session.sendReply",
          "when": "resourcePath =~ /[\\\\/]reply-drafts[\\\\/][0-9a-f]+\\.md$/",
          "group": "navigation@0"
        },
        {
          "command": "migent.session.discardReply",
          "when": "resourcePath =~ /[\\\\/]reply-drafts[\\\\/][0-9a-f]+\\.md$/",
          "group": "1_modification"
        }
      ],
      "migent.results.more": [
        {
          "command": "migent.session.copyId",
          "group": "1_session@1"
        },
        {
          "command": "migent.session.revealInExplorer",
          "group": "1_session@2"
        },
        {
          "command": "migent.session.openQuestions",
          "group": "1_session@3"
        },
        {
          "command": "migent.session.complete",
          "group": "2_manage@1"
        },
        {
          "command": "migent.session.rename",
          "group": "2_manage@2"
        }
      ]
    },
    "submenus": [
      {
        "id": "migent.results.more",
        "label": "More Actions",
        "icon": "$(ellipsis)"
      }
    ]
  },
  "scripts": {
    "setup:git": "node scripts/setup-git.mjs",
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:integration": "node scripts/integration/run.mjs",
    "package": "vsce package --no-dependencies",
    "lint": "node scripts/wrappers/run-eslint.mjs",
    "lint:strict": "node scripts/wrappers/run-eslint.mjs --max-warnings 0",
    "lint:fix": "node scripts/wrappers/run-eslint.mjs --fix",
    "lint:md": "node scripts/docs/lint-md.mjs",
    "lint:md:fix": "node scripts/docs/lint-md.mjs --fix",
    "lint:md:links": "node scripts/docs/lint-md-links.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nodeint/migent-contracts": "0.6.0",
    "@types/node": "^26.6.5",
    "@types/vscode": "1.93.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
